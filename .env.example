# Copy to .env and fill in real values. Never commit the real .env file.

# Generate with: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# From the OAuth app you create in Forgejo (Settings -> Applications) after Forgejo's
# first-run setup -- redirect URI must be exactly http://woodpecker-server:8000/authorize
WOODPECKER_FORGEJO_CLIENT=
WOODPECKER_FORGEJO_SECRET=
